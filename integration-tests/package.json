  "license": "ISC",
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.5.2",
    "@stellar/stellar-sdk": "14.2.0",
    "bigint-conversion": "^2.4.3",
    "bignumber.js": "^9.3.1",
    "chai": "^6.0.1",
    "chai-as-promised": "^8.0.2",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.2",
    "mocha": "^11.7.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
