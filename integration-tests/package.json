  "devDependencies": {
    "@types/chai": "4.3.20",
    "@types/chai-as-promised": "7.1.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.19.17",
    "@stellar/stellar-sdk": "14.2.0",
    "bigint-conversion": "^2.4.3",
    "bignumber.js": "^9.3.1",
    "chai": "4.5.0",
    "chai-as-promised": "7.1.2",
    "cross-env": "7.0.3",
    "dotenv": "16.6.1",
    "mocha": "10.8.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
